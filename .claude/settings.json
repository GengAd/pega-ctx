{
  "permissions": {
    "deny": [
      "Read(./.infinity-rules-mcp/**)",
      "Read(~/.infinity-rules-mcp/oauth-session.json)",
      "Bash(git push:*)",
      "Bash(git remote add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.mjs\"" }
        ]
      }
    ]
  }
}
